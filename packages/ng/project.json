{
  "name": "@mezzanine-ui/ng",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/ng",
  "projectType": "library",
  "tags": ["type:lib", "framework:angular"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng-packagr -p ng-package.json",
        "cwd": "packages/ng"
      },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        "@mezzanine-ui/system:build",
        "@mezzanine-ui/icons:build",
        "@mezzanine-ui/core:build"
      ]
    },
    "build:clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist && ng-packagr -p ng-package.json",
        "cwd": "packages/ng"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest",
        "cwd": "packages/ng"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --coverage",
        "cwd": "packages/ng"
      }
    }
  }
}
